/* chamada pelo Turnstile (data-callback) ao concluir a verificação:
   limpa a mensagem de erro que ficou de uma tentativa anterior */
function turnstileCleanError() {
    var el = document.getElementById('turnstile-error');
    if (el) { el.innerHTML = ''; el.style.display = 'none'; }
}
function validateTurnstile() {
    var ok = false;
    try {
        if (typeof turnstile !== 'undefined') {
            var resp = turnstile.getResponse();
            ok = resp && resp.length > 0;
        }
    } catch (e) {}
    var el = document.getElementById('turnstile-error');
    if (ok) {
        if (el) { el.innerHTML = ''; el.style.display = 'none'; }
        return true;
    }
    if (el) {
        el.style.display = 'block';
        el.innerHTML = 'Por favor, complete a verificação de segurança.';
    }
    return false;
}
</script>
