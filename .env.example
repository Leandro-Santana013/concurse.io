# =============================================================================
# CONCURSE.IO - VARIÁVEIS DE AMBIENTE
# =============================================================================

# Banco de Dados
# Se não for informado, a aplicação usa SQLite local automaticamente (concurse.db).
# Para PostgreSQL:
# DATABASE_URL=postgresql://concurse_user:concurse_password@localhost:5432/concurse_db

# Configurações do Docker Compose (Opcional)
POSTGRES_DB=concurse_db
POSTGRES_USER=concurse_user
POSTGRES_PASSWORD=concurse_password

# Login com Google
# Cadastre esta URI em "Authorized redirect URIs" no Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
GOOGLE_CLOCK_SKEW_SECONDS=60
FRONTEND_URL=http://localhost:5173

# Gere um valor aleatório longo para assinar os cookies de sessão.
SESSION_SECRET=

# Chave exclusiva para AES-GCM dos dados pessoais. Use ao menos 32 bytes aleatórios.
# Se vazia, SESSION_SECRET é usada com derivação separada para manter compatibilidade local.
# Durante rotação, mantenha as chaves antigas separadas por vírgula até o backfill concluir.
USER_DATA_ENCRYPTION_KEY=
USER_DATA_ENCRYPTION_KEY_PREVIOUS=

# Em produção, os dois valores abaixo devem ser true e a aplicação deve estar atrás de HTTPS.
SESSION_COOKIE_SECURE=false
FORCE_HTTPS=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://tauri.localhost

# IDs internos autorizados a alterar/reprocessar/excluir provas globais. Vazio bloqueia todos.
APP_ADMIN_USER_IDS=

# Somente para testes locais explícitos; mantenha falso no uso normal.
AUTH_DEV_BYPASS=false

# Rede mesh privada (opcional; o servidor usa SESSION_SECRET como fallback).
# Cada nó deve compartilhar o mesmo segredo e ter um identificador único.
MESH_SHARED_SECRET=
MESH_NODE_ID=
MESH_CONTENT_DIR=mesh_data/content
# Blocos e limites de transporte da malha. 1 MiB funciona bem em celular;
# aumente somente se os peers tiverem rede estável e pouca latência.
MESH_CHUNK_SIZE=1048576
MESH_FETCH_CONCURRENCY=8
MESH_PEER_TIMEOUT_SECONDS=8
MESH_PEER_CONNECT_TIMEOUT_SECONDS=3
MESH_HTTP_MAX_CONNECTIONS=32
MESH_HTTP_KEEPALIVE=16
