# Hostname escolhido no DuckDNS. Aponte o registro A para o IP público da VM.
DOMAIN=concurse.duckdns.org

# Banco Supabase já usado pelo projeto. Copie somente o valor DATABASE_URL
# do .env existente; não copie o arquivo inteiro.
DATABASE_URL=COLE_A_DATABASE_URL_EXISTENTE

# Mantenha estas origens no mesmo hostname.
FRONTEND_URL=https://concurse.duckdns.org
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://concurse.duckdns.org/api/v1/auth/google/callback
GOOGLE_CLOCK_SKEW_SECONDS=60

# Preserve a chave atual: use o valor FLASK_SECRET_KEY do .env existente
# nos dois campos para manter sessões e dados de usuário legíveis.
SESSION_SECRET=COLE_A_CHAVE_ATUAL_FLASK_SECRET_KEY
USER_DATA_ENCRYPTION_KEY=COLE_A_CHAVE_ATUAL_FLASK_SECRET_KEY
USER_DATA_ENCRYPTION_KEY_PREVIOUS=

SESSION_COOKIE_SECURE=true
FORCE_HTTPS=true
CORS_ORIGINS=https://concurse.duckdns.org
APP_ADMIN_USER_IDS=
AUTH_DEV_BYPASS=false
