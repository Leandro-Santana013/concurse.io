# Hostname escolhido no DuckDNS. Aponte o registro A para o IP público da VM.
DOMAIN=concurse.duckdns.org

# Banco Supabase já usado pelo projeto. Copie somente o valor DATABASE_URL
# do .env existente; não copie o arquivo inteiro.
DATABASE_URL=COLE_A_DATABASE_URL_EXISTENTE

# Mantenha estas origens no mesmo hostname.
FRONTEND_URL=https://concurse.duckdns.org
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://concurse.duckdns.org/api/v1/auth/google/callback
GOOGLE_CLOCK_SKEW_SECONDS=60

# Bridge do Supabase Auth para a sessão interna da API.
SUPABASE_URL=https://pvojiokewtteroaraykk.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_B_5ggWu2WVGYsi02iyN1Ng_HBBRBW9F

# Preserve a chave atual: use o valor FLASK_SECRET_KEY do .env existente
# nos dois campos para manter sessões e dados de usuário legíveis.
SESSION_SECRET=COLE_A_CHAVE_ATUAL_FLASK_SECRET_KEY
USER_DATA_ENCRYPTION_KEY=COLE_A_CHAVE_ATUAL_FLASK_SECRET_KEY
USER_DATA_ENCRYPTION_KEY_PREVIOUS=

SESSION_COOKIE_SECURE=true
FORCE_HTTPS=true
CORS_ORIGINS=https://concurse.duckdns.org,http://tauri.localhost
APP_ADMIN_USER_IDS=
AUTH_DEV_BYPASS=false

# Oracle Object Storage (segredos somente no servidor; nunca no desktop/mobile).
# O bucket deve permanecer privado. O namespace aparece em Object Storage >
# detalhes do bucket. A chave PEM pode vir de um secret manager ou de um
# arquivo montado no container, em vez de ser gravada neste arquivo.
OCI_OBJECT_STORAGE_NAMESPACE=
OCI_OBJECT_STORAGE_BUCKET=concurseio-media
OCI_OBJECT_STORAGE_REGION=sa-saopaulo-1
OCI_OBJECT_STORAGE_TENANCY=
OCI_OBJECT_STORAGE_USER=
OCI_OBJECT_STORAGE_FINGERPRINT=
OCI_OBJECT_STORAGE_PRIVATE_KEY=
OCI_OBJECT_STORAGE_PRIVATE_KEY_FILE=
OCI_OBJECT_STORAGE_PRIVATE_KEY_PASSPHRASE=
OCI_OBJECT_STORAGE_QUESTION_PREFIX=questions
