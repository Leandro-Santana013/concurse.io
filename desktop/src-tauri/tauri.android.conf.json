{
  "version": "0.1.7",
  "build": {
    "beforeDevCommand": "npm --prefix ../frontend run dev -- --host 0.0.0.0",
    "beforeBuildCommand": "node scripts/prepare-android-engine.mjs && npm --prefix ../frontend run build:mobile"
  },
  "bundle": {
    "externalBin": [],
    "android": {
      "minSdkVersion": 24,
      "versionCode": 8
    }
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "scheme": ["concurse"],
          "appLink": false
        }
      ]
    }
  }
}
