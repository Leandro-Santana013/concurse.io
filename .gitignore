# =============================================================================
# CONCURSE.IO — .gitignore
# =============================================================================

# Python & Environments
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
venv/
.venv/
env/
ENV/

# Environment Variables & Secrets
.env
.env.local
.env.*.local
!.env.example
qc_cookies.json
*.pem
*.key

# Database & SQLite Files (Locks, WAL, Journals)
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite
*.sqlite3

# Datasets, Scraped PDFs & Heavy Media
pdfs/
static/pdfs/
provas_bancas/
*.zip
*.tar.gz
*.rar
*.7z
test.pdf
static/images/questions/

# Frontend (Node, Vite & Bundles)
node_modules/
**/node_modules/
dist/
**/dist/
.vite/
**/.vite/
dist-ssr/

# Scraping & Browser Temp (Playwright, Selenium)
pw_dl_*/
pw_user_data/
.playwright/

# IDE & Editor Configs
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*.suo

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# Rust Artifacts
rust_engine/target/
**/target/
*.pyd
*.whl

# Logs & Test Caches
*.log
npm-debug.log*
yarn-debug.log*
.pytest_cache/
.coverage
htmlcov/
